version = 0.1

# Copy to samconfig.toml (gitignored) and replace every REPLACE_ME before deploy.
# Do not commit real Vault credentials or Okta client secrets.

[default.deploy.parameters]
stack_name = "external-api-sample"
resolve_s3 = true
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
parameter_overrides = [
  "StageName=prod",
  "AuthorizerFunctionName=external-api-okta-authorizer",
  "ProxyFunctionName=external-api-proxy",
  "OktaIssuer=https://your-domain.okta.com/oauth2/default",
  "OktaClientId=REPLACE_ME",
  "OktaAudience=api://external",
  "VaultAddr=https://vault.example.com:8200",
  "VaultRoleId=REPLACE_ME",
  "VaultSecretId=REPLACE_ME",
  "VaultOktaSecretPath=secret/data/external-api/okta",
  "VaultOktaSecretKey=client_secret",
  "VaultNamespace=",
  "VaultSecretCacheSeconds=300",
  "UpstreamBaseUrl=https://internal.example.net/api"
]
